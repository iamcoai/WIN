# Neon — https://console.neon.tech → project → connection string
# Use the pooled endpoint (-pooler host) for runtime, the direct endpoint
# for drizzle-kit push/migrations (DATABASE_URL_UNPOOLED).
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# BetterAuth — generate with `npx @better-auth/cli secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET=<32-byte-base64>
BETTER_AUTH_URL=http://localhost:3001

# Plug and Pay — merchant PAT (never expose as NEXT_PUBLIC_*)
PLUGANDPAY_API_KEY=<jwt>

# cal.diy webhook — same value as the "Secret" field on the webhook in
# cal.diy (Settings → Developer → Webhooks). HMAC-SHA256 verification.
CAL_WEBHOOK_SECRET=<random-hex>

# Supabase public-safe keys (for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://ujlkvaxlmrsvzgmlakgn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
